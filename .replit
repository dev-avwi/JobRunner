modules = ["nodejs-24", "python-base-3.13", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Expo"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "schema-imports"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "dispatch-skeleton-e2e"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "schema-drift-check"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "check-vite-aliases"

[[workflows.workflow]]
name = "Expo"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd mobile && npx expo start --port 8082"
waitForPort = 8082

[[workflows.workflow]]
name = "schema-imports"
author = "agent"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/scripts run check-schema-imports && pnpm --filter @workspace/scripts run check-schema-imports:test"

[[workflows.workflow]]
name = "dispatch-skeleton-e2e"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd artifacts/jobrunner && PORT=22128 npx playwright test --config playwright.config.ts"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "schema-drift-check"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "SCHEMA_DRIFT_CHECK=1 pnpm --filter @workspace/api-server test --run src/__tests__/schemaDriftCheck.test.ts"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "check-vite-aliases"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/jobrunner run check:aliases"

[workflows.workflow.metadata]
isValidation = true

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 180000

[nix]
channel = "stable-25_05"
packages = ["chromium"]

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 8081

[[ports]]
localPort = 8082
externalPort = 3001

[[ports]]
localPort = 8083
externalPort = 3002

[[ports]]
localPort = 22128
externalPort = 80

[[ports]]
localPort = 23636
externalPort = 3000

[objectStorage]
defaultBucketID = "replit-objstore-4fa89116-1ef0-4336-9074-4702c79f1e78"
