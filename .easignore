# Root-level easignore — prevents EAS from archiving non-mobile workspace content
# when it traverses up from mobile/ to detect the pnpm monorepo root.

# Large asset folder not needed by the mobile build
attached_assets/

# Migration backup
.migration-backup/

# Web/API artifacts — not part of the mobile build
artifacts/

# Workspace-root node_modules (EAS reinstalls inside mobile/)
node_modules/

# Build outputs
dist/
lib/

# Git history
.git/

# Replit internals
.local/
.agents/
.cache/
.config/

# IDE
.idea/
.vscode/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Misc
.DS_Store
