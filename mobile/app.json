    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-apple-authentication",
      [
        "@stripe/stripe-terminal-react-native",
        {
          "bluetoothBackgroundMode": false
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.0",
            "useFrameworks": "static",
            "ccacheEnabled": true,
            "extraPods": [
              {
                "name": "SocketRocket",
                "modular_headers": true
              }
            ]
          },
          "android": {
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "buildToolsVersion": "35.0.0",
            "minSdkVersion": 26,
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "extraProguardRules": "-keep class com.stripe.stripeterminal.** { *; }\n-keep interface com.stripe.stripeterminal.** { *; }\n-dontwarn com.stripe.stripeterminal.**\n-keep class io.sentry.** { *; }\n-keep interface io.sentry.** { *; }\n-dontwarn io.sentry.**\n-keep class com.swmansion.reanimated.** { *; }\n-keep class com.facebook.react.turbomodule.** { *; }\n-dontwarn com.swmansion.reanimated.**\n-keep class com.facebook.hermes.** { *; }\n-keep class com.facebook.jni.** { *; }\n-dontwarn com.facebook.hermes.**\n-keep class okhttp3.** { *; }\n-keep interface okhttp3.** { *; }\n-keep class okio.** { *; }\n-dontwarn okhttp3.**\n-dontwarn okio.**\n-keep class expo.modules.** { *; }\n-keep interface expo.modules.** { *; }\n-dontwarn expo.modules.**\n-keep class com.facebook.react.bridge.** { *; }\n-keep class com.facebook.react.uimanager.** { *; }\n-dontwarn com.facebook.react.**"
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/jobrunner-logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#fafafa",
          "dark": {
            "image": "./assets/jobrunner-logo.png",
            "backgroundColor": "#121417"
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "JobRunner uses your camera to take before-and-after photos of job sites, attach photo evidence to quotes and invoices, and scan documents for your records."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "JobRunner accesses your photo library so you can attach existing site photos to jobs, quotes, and invoices as visual records for your clients.",
          "cameraPermission": "JobRunner uses your camera to take before-and-after photos of job sites, attach photo evidence to quotes and invoices, and scan documents for your records."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "JobRunner uses your background location so your team's live positions appear on the dispatch map and to automatically clock you in and out when you arrive at or leave a job site using geofence technology. Your location is only shared with your team owner or manager.",
          "locationWhenInUsePermission": "JobRunner uses your location to show your position on the dispatch map, display nearby job sites, calculate travel distance for timesheets, and provide navigation to your next job.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#E8862E"
        }
      ],
      "./plugins/withIAPStoreFlavor",
      "./plugins/withIAPKotlinFix",
      "./plugins/withLiveActivity",
      "./plugins/withAndroidFoldableConfigChanges"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "78e88ca7-014e-438b-8170-1ccae4cd9386",
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
