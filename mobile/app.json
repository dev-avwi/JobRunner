              "scheme": "https",
              "host": "jobrunner.com.au",
              "pathPrefix": "/verify-email"
            },
            {
              "scheme": "https",
              "host": "jobrunner.com.au",
              "pathPrefix": "/accept-invite"
            },
            {
              "scheme": "https",
              "host": "jobrunner.com.au",
              "pathPrefix": "/reset-password"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        },
        {
          "action": "VIEW",
          "autoVerify": false,
          "data": [
            {
              "scheme": "jobrunner",
              "host": "verify-email"
            },
            {
              "scheme": "jobrunner",
              "host": "accept-invite"
            },
            {
