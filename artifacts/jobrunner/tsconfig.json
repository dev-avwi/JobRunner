{
  "extends": "../../tsconfig.base.json",
  "include": ["src/**/*"],
  "exclude": ["node_modules", "build", "dist", "**/*.test.ts"],
  "compilerOptions": {
    "noEmit": true,
    "jsx": "preserve",
    "lib": ["esnext", "dom", "dom.iterable"],
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "moduleResolution": "bundler",
    "types": ["node", "vite/client"],
    "paths": {
      "@/*": ["./src/*"],
      "@shared/schema": ["../../lib/db/src/schema/schema.ts"],
      "@shared/permissions": ["../../lib/db/src/schema/permissions.ts"],
      "@shared/dateUtils": ["./src/lib/shared-dateUtils.ts"],
      "@shared/displayName": ["./src/lib/shared-displayName.ts"],
      "@shared/tradeCatalog": ["./src/lib/shared-tradeCatalog.ts"]
    }
  },
  "references": [
    {
      "path": "../../lib/api-client-react"
    }
  ]
}
